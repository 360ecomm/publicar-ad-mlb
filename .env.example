# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=mlb_user
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=publicar_ad_mlb

# --- Redis ---
REDIS_PASSWORD=troque_esta_senha_redis

# --- pgAdmin (opcional, apenas dev) ---
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=troque_esta_senha_pgadmin

# --- Backend / FastAPI ---
SECRET_KEY=gere_com__openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chave de criptografia Fernet (para tokens ML no banco)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Mercado Livre ---
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/api/v1/auth/ml/callback

# --- Provedor de IA (escolha um) ---
# Google Gemini
GEMINI_API_KEY=
# Nome explicito, nunca alias "-latest": o alias troca de modelo por baixo
# sem deploy (ver comentario em backend/app/config.py).
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (alternativa)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- OpenAI (motor de geração de imagens) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Provedor ativo: "gemini" ou "claude"
AI_PROVIDER=gemini

# --- Cloudflare R2 (storage de imagens) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=publicar-ad-mlb
R2_PUBLIC_URL=https://pub-SEU_ID.r2.dev

# Bucket R2 DEDICADO para imagens geradas por IA (write-back na geracao).
# Distinto do bucket de fotos brutas dos sellers. Vazio = desligado.
R2_ASSET_BUCKET_NAME=r2-mktp-img-ia
R2_ASSET_BUCKET_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ASSET_BUCKET_ACCESS_KEY_ID=
R2_ASSET_BUCKET_SECRET_ACCESS_KEY=

# --- Ambiente ---
ENVIRONMENT=development
LOG_LEVEL=INFO
